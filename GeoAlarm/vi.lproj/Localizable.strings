"trigger.mode.footer" = "Chọn cách thiết lập báo thức mới. Chế độ thời gian đánh thức bạn trước khi đến một số phút đã đặt, ước tính theo tốc độ di chuyển — và dùng nhiều GPS và pin hơn khi bạn đến gần. Báo thức hiện có giữ thiết lập riêng của chúng.";

/* Dead reckoning (per-alarm, time mode only) */
"Dead Reckoning on Signal Loss" = "Định vị suy đoán khi mất tín hiệu";
"deadReckoning.toggle.subtitle" = "Bù đắp các khoảng mất GPS ngắn bằng cách ước tính tiến trình của bạn";
"deadReckoning.info.body" = "Giữ báo thức theo thời gian đúng lịch trình trong một khoảng mất GPS ngắn — đường hầm, nhà ga, khu nhà cao tầng dày đặc — bằng cách ước tính quá trình tiếp cận của bạn từ tốc độ đã biết gần nhất, thay vì lập tức chuyển sang phương án dự phòng theo khoảng cách gần.\n\nBật tính năng này nếu bạn thường xuyên đi trên một tuyến đường mà GPS thường mất tín hiệu ngay trước điểm dừng của bạn.\n\nMặc định tắt: ước tính này là một phỏng đoán theo đường thẳng, không phải vị trí thực. Nếu tốc độ của bạn thay đổi đột ngột trong khoảng mất tín hiệu — ví dụ tàu dừng lại — báo thức có thể reo sớm một chút. Nó chỉ có thể reo sớm, không bao giờ trễ; phương án dự phòng theo khoảng cách gần vẫn bảo vệ bạn nếu ước tính hết hạn. Nếu báo thức reo quá sớm trên một tuyến đường mà bạn đã bật tính năng này, hãy thử tăng bán kính hoặc thời gian báo trước cho báo thức đó.";

/* Help: time-based alarms */
"Trigger: distance or time" = "Kích hoạt: khoảng cách hoặc thời gian";
"help.body.timeBased" = "Chọn cách báo thức kích hoạt khi bạn tạo nó (hoặc đặt mặc định trong Cài đặt → Kích hoạt báo thức):\n\n• Khoảng cách — kích hoạt khi bạn vượt một khoảng cách đã đặt (bán kính) từ ghim. Phù hợp với ranh giới cố định như một nhà ga.\n\n• Thời gian (trước khi đến) — kích hoạt trước khi bạn đến nơi một số phút đã đặt, dựa trên tốc độ di chuyển. Rất hợp để ngủ trên tàu hoặc xe buýt — ví dụ: “đánh thức tôi 5 phút trước điểm dừng.”\n\nChế độ thời gian dùng nhiều GPS (và pin) hơn khi đến gần, và hoạt động tốt nhất trên tuyến đường thoáng; trong hầm dài, nó chuyển về kích hoạt theo khoảng cách gần.";
"help.body.deadReckoning" = "Định vị suy đoán khi mất tín hiệu là một cài đặt tùy chọn cho từng báo thức, dành cho báo thức theo thời gian (Kích hoạt: khoảng cách hoặc thời gian). Bật tính năng này từ màn hình tạo báo thức bằng công tắc bên dưới \"Đánh thức trước khi đến\", hoặc chạm vào biểu tượng ⓘ bên cạnh để xem giải thích ngắn gọn.\n\nThông thường, nếu mất GPS trong giai đoạn tiếp cận cuối cùng — đường hầm, nhà ga, khu nhà cao tầng dày đặc — báo thức sẽ chuyển sang phương án dự phòng theo khoảng cách gần cho đến khi có tín hiệu trở lại. Khi bật Định vị suy đoán, GeoNap sẽ ước tính quá trình tiếp cận của bạn từ tốc độ đã biết gần nhất trong một khoảng thời gian ngắn, có giới hạn, tỷ lệ theo thời gian báo trước của báo thức, để báo thức vẫn có thể reo gần với thời gian báo trước đã yêu cầu thay vì chỉ khi bạn đã ở gần điểm đến.\n\nTính năng này mặc định tắt vì ước tính là một phỏng đoán theo đường thẳng, không phải vị trí GPS thực — nó không thể tính đến việc tàu giảm tốc, dừng lại, hoặc đổi tốc độ trong khoảng mất tín hiệu. Bất kỳ sai số nào cũng chỉ có thể khiến báo thức reo sớm một chút, không bao giờ trễ, vì phương án dự phòng theo khoảng cách gần luôn được áp dụng.\n\nBật tính năng này cho các tuyến đường mà bạn biết GPS thường mất tín hiệu gần điểm dừng của mình — ví dụ, một đường hầm tàu quen thuộc ngay trước ga của bạn. Nếu thấy báo thức reo quá sớm trên một tuyến đường cụ thể, hãy tăng thời gian báo trước hoặc bán kính cho báo thức đó.";

/* PrivacyView: Auto-Notify Contacts + Apple Watch (2026-07-11) */
"Auto-Notify Contacts" = "Liên hệ Tự động thông báo";
"Apple Watch" = "Apple Watch";
"privacy.body.contacts" = "Nếu bạn dùng tính năng tùy chọn Tự động thông báo, bạn có thể chọn các liên hệ để tự động nhắn tin khi báo thức kích hoạt. Việc chọn liên hệ sử dụng trình chọn liên hệ hệ thống của Apple — GeoNap không bao giờ có quyền truy cập hàng loạt hay liên tục vào danh bạ của bạn, chỉ (những) liên hệ bạn chọn.\n\nVới mỗi liên hệ bạn thêm, GeoNap chỉ lưu tên và số điện thoại hoặc email của họ — không lưu gì khác từ thẻ liên hệ. Dữ liệu này được lưu bằng SwiftData và, giống như báo thức của bạn, được đồng bộ tùy chọn qua iCloud để các liên hệ Tự động thông báo của bạn xuất hiện trên các thiết bị khác đăng nhập cùng Apple ID.\n\nThông tin liên hệ không bao giờ được gửi đến bất kỳ máy chủ nào do tôi vận hành. Nó chỉ được dùng để gửi tin nhắn bạn đã cấu hình, qua Tin nhắn hoặc một automation Shortcuts do bạn kiểm soát. Bạn có thể xóa một liên hệ khỏi báo thức hoặc khỏi danh sách mặc định Tự động thông báo bất cứ lúc nào trong Cài đặt.";
"privacy.body.appleWatch" = "Nếu bạn dùng GeoNap với Apple Watch đã ghép nối, ứng dụng iPhone sẽ chia sẻ các báo thức đang hoạt động của bạn (tên, khu vực suy ra từ vị trí, bán kính và trạng thái) với ứng dụng Watch để nó có thể hiển thị và cảnh báo cho bạn.\n\nDữ liệu này được gửi trực tiếp giữa các thiết bị bằng framework WatchConnectivity của Apple; nó không bao giờ đi qua bất kỳ máy chủ nào do tôi vận hành. Trên Watch, dữ liệu được lưu trong một App Group dùng chung, cục bộ trên thiết bị đó, để cả ứng dụng Watch và complication của nó có thể đọc được — dữ liệu không được đồng bộ lên iCloud từ Watch.\n\nNếu bạn bật nhật ký gỡ lỗi tùy chọn, nó có thể ghi lại thời điểm Watch được ghép nối hoặc hủy ghép nối, hoặc khi ứng dụng GeoNap trên Watch được cài đặt hoặc gỡ bỏ, để giúp chẩn đoán sự cố đồng bộ. Nó không ghi lại dữ liệu báo thức của bạn. Việc gỡ cài đặt GeoNap khỏi Watch, hoặc hủy ghép nối Watch, sẽ xóa bản sao dùng chung này.";

