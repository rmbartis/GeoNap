/* Time-based alarms (trigger mode) */
"trigger.mode.distance" = "Distanza (raggio)";
"trigger.mode.time" = "Tempo (prima dell'arrivo)";
"trigger.mode.label" = "Attiva per";
"trigger.leadTime.label" = "Svegliami prima dell'arrivo";
"trigger.leadTime.value" = "%d min";
"trigger.leadTime.help" = "Si attiva all'incirca questi minuti prima di raggiungere la destinazione, in base alla tua velocità di viaggio.";
"trigger.mode.footer" = "Scegli come vengono impostate le nuove sveglie. La modalità Tempo ti sveglia un numero prestabilito di minuti prima dell'arrivo, stimato dalla tua velocità di viaggio, e usa più GPS e batteria quando ti avvicini. Le sveglie esistenti mantengono la propria impostazione.";

/* Dead reckoning (per-alarm, time mode only) */
"Dead Reckoning on Signal Loss" = "Stima della posizione in caso di perdita di segnale";
"deadReckoning.toggle.subtitle" = "Colma brevi interruzioni GPS stimando i tuoi progressi";
"deadReckoning.info.body" = "Mantiene una sveglia basata sul tempo in orario durante una breve interruzione GPS — una galleria, una stazione, un isolato denso di edifici — stimando il tuo avvicinamento in base all'ultima velocità nota, invece di ricorrere subito al backstop di prossimità a corto raggio.\n\nAttivalo se percorri regolarmente un tragitto in cui il GPS si interrompe in modo affidabile appena prima della tua fermata.\n\nDisattivato per impostazione predefinita: la stima è una supposizione in linea retta, non una posizione reale. Se la tua velocità cambia bruscamente durante l'interruzione — il treno si ferma, per esempio — la sveglia potrebbe suonare un po' in anticipo. Può solo suonare in anticipo, mai in ritardo; il backstop di prossimità continua comunque a coprirti se la stima si esaurisce. Se le sveglie suonano troppo presto su un tragitto in cui hai attivato questa opzione, prova un raggio maggiore o un tempo di anticipo più lungo per quella sveglia.";

/* Help: time-based alarms */
"Trigger: distance or time" = "Attivazione: distanza o tempo";
"help.body.timeBased" = "Scegli come si attiva una sveglia quando la crei (o imposta un valore predefinito in Impostazioni → Attivazione sveglia):\n\n• Distanza — si attiva quando superi una distanza fissa (il raggio) dal tuo segnaposto. Ideale per un confine fisso come una singola stazione.\n\n• Tempo (prima dell’arrivo) — si attiva un certo numero di minuti prima di raggiungere la destinazione, in base alla tua velocità. Perfetto per dormire in treno o autobus — ad esempio: “svegliami 5 minuti prima della mia fermata.”\n\nLa modalità Tempo usa più GPS (e batteria) quando ti avvicini e funziona meglio su tratte aperte; nelle gallerie lunghe ripiega su un’attivazione per distanza ravvicinata.";
"help.body.deadReckoning" = "Stima della posizione in caso di perdita di segnale è un'impostazione opzionale, per singola sveglia, per le sveglie basate sul tempo (Attivazione: distanza o tempo). Attivala dalla schermata di creazione della sveglia con l'interruttore sotto \"Svegliami prima dell'arrivo\", oppure tocca la ⓘ accanto per una spiegazione rapida.\n\nNormalmente, se il GPS si perde durante l'avvicinamento finale — una galleria, una stazione, un isolato denso di edifici — la sveglia ricorre al backstop di prossimità a corto raggio finché non torna un segnale. Con questa opzione attiva, GeoNap stima invece il tuo avvicinamento in base all'ultima velocità nota per una finestra breve e limitata, proporzionata al tempo di anticipo della sveglia, così la sveglia può comunque suonare vicino al tempo di anticipo richiesto invece che solo quando sei già vicino alla destinazione.\n\nÈ disattivata per impostazione predefinita perché la stima è una supposizione in linea retta, non una posizione GPS reale — non può tenere conto del treno che rallenta, si ferma o cambia velocità durante l'interruzione. Qualsiasi imprecisione può solo far suonare la sveglia un po' in anticipo, mai in ritardo, poiché il backstop di prossimità si applica comunque sempre.\n\nAttivala per i tragitti in cui sai che il GPS si interrompe in modo affidabile vicino alla tua fermata — per esempio, una galleria ferroviaria familiare appena prima della tua stazione. Se noti che suona troppo presto su un tragitto specifico, aumenta il tempo di anticipo o il raggio di quella sveglia.";

/* PrivacyView: Auto-Notify Contacts + Apple Watch (2026-07-11) */
"Auto-Notify Contacts" = "Contatti Auto-Notifica";
"Apple Watch" = "Apple Watch";
"privacy.body.contacts" = "Se usi la funzione opzionale Auto-Notifica, puoi scegliere dei contatti da avvisare automaticamente quando una sveglia si attiva. La scelta di un contatto usa il selettore di contatti di sistema di Apple — GeoNap non ottiene mai un accesso massivo o continuo alla tua rubrica, solo al contatto o ai contatti che scegli.\n\nPer ogni contatto aggiunto, GeoNap memorizza solo il suo nome e numero di telefono o indirizzo email — nient'altro dalla sua scheda contatto. Questo viene salvato tramite SwiftData e, come le tue sveglie, è sincronizzato facoltativamente tramite iCloud in modo che i tuoi contatti Auto-Notifica compaiano sugli altri tuoi dispositivi con lo stesso ID Apple.\n\nLe informazioni di contatto non vengono mai trasmesse a nessun server da me gestito. Vengono usate solo per indirizzare il messaggio che configuri, inviato tramite Messaggi o un'automazione Comandi Rapidi sotto il tuo controllo. Puoi rimuovere un contatto da una sveglia o dai valori predefiniti di Auto-Notifica in qualsiasi momento dalle Impostazioni.";
"privacy.body.appleWatch" = "Se usi GeoNap con un Apple Watch abbinato, l'app iPhone condivide le tue sveglie attive (nome, area derivata dalla posizione, raggio e stato) con l'app Watch così che possa mostrarle e avvisarti.\n\nQuesti dati vengono inviati da dispositivo a dispositivo tramite il framework WatchConnectivity di Apple; non passano mai da alcun server da me gestito. Sull'Watch, vengono memorizzati in un contenitore di App Group condiviso e locale a quel dispositivo, così che sia l'app Watch sia la sua complicazione possano leggerli — non vengono sincronizzati con iCloud dall'Watch.\n\nSe attivi il log di debug opzionale, questo può registrare quando un Watch viene abbinato o disabbinato, o quando l'app GeoNap Watch viene installata o rimossa, per aiutare a diagnosticare problemi di sincronizzazione. Non registra i dati delle tue sveglie. Disinstallare GeoNap dal tuo Watch, o disabbinarlo, rimuove questa copia condivisa.";
