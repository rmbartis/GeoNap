/* HelpView — Auto-Notify section */
"help.body.autoNotify" = "La Notifica automatica invia un messaggio ai tuoi contatti salvati nel momento in cui una sveglia scatta — attivata dalla tua posizione, senza alcuna azione da parte tua.\n\nCosa accade quando la sveglia scatta (standard):\n• GeoNap rileva che sei entrato o uscito dall'area del geofence.\n• La prossima volta che porti GeoNap in primo piano, l'app Messaggi si apre automaticamente.\n• Il messaggio è già indirizzato e precompilato — per esempio: «[Arrivo] Sono arrivato/a a Milano Centrale alle 9:14».\n• Tocca Invia per confermare.\n\nInviare senza approvazione (configurazione una tantum):\nPuoi saltare del tutto il passaggio Tocca Invia usando un'Automazione personale di Comandi rapidi. Una volta configurata, iOS invia il messaggio alla successiva apertura di GeoNap dopo una sveglia — senza schermata di composizione e senza toccare Invia. (iOS non ha un trigger di notifica e non può inviare SMS del tutto in background, quindi GeoNap deve essere aperta.)\n\nVedi Impostazioni → Auto-SMS (senza approvazione) per le istruzioni passo passo.\n\nPer attivare la Notifica automatica su una sveglia:\n1. Quando crei o modifichi una sveglia, attiva l'interruttore Notifica automatica.\n2. Tocca Aggiungi dai Contatti per scegliere una persona dalla rubrica, oppure Aggiungi manualmente per inserire un numero di telefono.\n3. Tocca Salva sveglia.\n\nValori predefiniti globali: in Impostazioni → Valori predefiniti Notifica automatica, aggiungi i contatti che verranno precompilati in ogni nuova sveglia con Notifica automatica attiva.\n\nNota: i messaggi vengono inviati tramite l'app Messaggi di iOS. Il dispositivo deve poter inviare SMS o iMessage ai contatti indicati.\n\nTempistica dell'invio: la Notifica automatica viene inviata solo quando interagisci con GeoNap, ad esempio aprendo l'app o interrompendo una sveglia. Se questo non avviene subito, il messaggio può arrivare più tardi rispetto alla sveglia stessa; non c'è alcun limite di tempo, quindi un'interazione tardiva lo invia comunque.\n\nUn solo messaggio in sospeso alla volta: se una seconda sveglia con Notifica automatica scatta prima che tu interagisca con l'app, viene inviata solo la notifica di viaggio più recente.";

/* Auto-SMS section (SettingsView) */
"Auto-SMS (No Approval Needed)" = "Auto-SMS (Senza approvazione)";
"settings.autoSMS.description" = "GeoNap può inviare un SMS ai tuoi contatti automaticamente quando scatta un allarme, senza schermata di composizione né tocco per inviare. Richiede una configurazione una tantum qui sotto.";
"settings.autoSMS.setupTitle" = "Come configurarlo:";
"settings.autoSMS.step1" = "Tocca Configura automazione qui sotto. Questo apre Comandi Rapidi con una nuova automazione personale.";
"settings.autoSMS.step2" = "Scorri verso il basso e tocca App, scegli GeoNap, assicurati che sia \"Viene aperta\" sia \"Esegui immediatamente\" siano selezionati, poi tocca Avanti.";
"settings.autoSMS.step3" = "Tocca Crea nuovo comando rapido. In Cerca azioni, aggiungi Notifica contatti tramite GeoNap.";
"settings.autoSMS.step4" = "Tocca Cerca azioni in basso, digita Se e aggiungi l'azione Se che appare. Tieni premuto il campo della condizione, tocca Seleziona variabile, scegli Notifica contatti tramite GeoNap, poi Testo, quindi nel menu \"è\" scegli Contiene un valore.";
"settings.autoSMS.step5" = "All'interno del blocco Se (tra Se e Altrimenti), tocca Cerca azioni, digita \"Ripeti\" e aggiungi Ripeti con ogni. Tieni premuto il campo di input, tocca Seleziona variabile, e scegli Notifica contatti tramite GeoNap, poi Destinatari.";
"settings.autoSMS.step6" = "All'interno del blocco Ripeti con ogni (tra Ripeti con ogni e Interrompi ripetizione), aggiungi Invia messaggio — l'icona verde di iMessage (SMS nativo Apple), non un'azione con nome simile di un'altra app di messaggistica.";
"settings.autoSMS.step7" = "In Invia messaggio, imposta i due campi separatamente: per Messaggio, tieni premuto il campo, tocca Seleziona variabile, e scegli Notifica contatti tramite GeoNap, poi Testo. Per Destinatari, tieni premuto il campo, tocca Seleziona variabile, e scegli Ripeti elemento — non direttamente \"Notifica contatti tramite GeoNap\", perché questo rimetterebbe l'intero elenco in un unico invio di gruppo. Lascia vuoti Altrimenti e Fine Se.";
"settings.autoSMS.step8" = "Tocca il segno di spunta blu in alto a destra per salvare.";
"settings.autoSMS.step9" = "Tornerai alla schermata di riepilogo delle automazioni, che mostra la nuova automazione \"Quando GeoNap viene aperta\".";
"settings.autoSMS.step10" = "Torna nelle Impostazioni di GeoNap e attiva \"Ho configurato l'automazione di Comandi Rapidi\" in alto.";
"Set Up Automation" = "Configura automazione";
"settings.autoSMS.footer" = "GeoNap non può rilevare un allarme finché l'app non è aperta, quindi l'automazione viene eseguita la prossima volta che apri GeoNap dopo un allarme. Attiva l'interruttore qui sopra così l'app non mostra anche la propria schermata di composizione.";
"settings.autoSMS.automationToggleHelp" = "Attivalo solo dopo aver completato la configurazione qui sotto, così GeoNap smette di mostrare la propria schermata di invio.";
"settings.autoSMS.automationToggle" = "Ho configurato l’automazione Comandi rapidi";
